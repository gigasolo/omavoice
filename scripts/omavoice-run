#!/usr/bin/env bash
# Generate an isolated PipeWire client config and exec it.
# This is the Omarchy speaker-tuning pattern: pipewire -c <our conf>, never
# the daemon's pipewire.conf.d and never stock filter-chain.conf.d.
set -euo pipefail

preset="meeting"
quality="better"
target=""
plugin_dir=""
dump=0
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/omavoice"

usage() {
  echo "Usage: omavoice-run [--dump] --preset meeting|podcast|clean [--quality good|better|best] --target <node.name> --dir <plugin-dir>" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --preset) preset="${2:-}"; shift 2 ;;
    --quality) quality="${2:-}"; shift 2 ;;
    --target) target="${2:-}"; shift 2 ;;
    --dir) plugin_dir="${2:-}"; shift 2 ;;
    --dump) dump=1; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

[[ -n $target && -n $plugin_dir ]] || usage
[[ $preset == meeting || $preset == podcast || $preset == clean ]] || usage
[[ $quality == good || $quality == better || $quality == best ]] || quality=better

rnnoise=""
for candidate in /usr/lib/ladspa/librnnoise_ladspa.so /usr/lib64/ladspa/librnnoise_ladspa.so; do
  if [[ -f $candidate ]]; then
    rnnoise=$candidate
    break
  fi
done

deepfilter=""
for candidate in /usr/lib/ladspa/libdeep_filter_ladspa.so /usr/lib64/ladspa/libdeep_filter_ladspa.so; do
  if [[ -f $candidate ]]; then
    deepfilter=$candidate
    break
  fi
done

webrtc=""
for candidate in /usr/lib/spa-0.2/aec/libspa-aec-webrtc.so /usr/lib64/spa-0.2/aec/libspa-aec-webrtc.so; do
  if [[ -f $candidate ]]; then
    webrtc=$candidate
    break
  fi
done

have_lsp=0
[[ -f /usr/lib/lv2/lsp-plugins.lv2/compressor_mono.ttl && -f /usr/lib/lv2/lsp-plugins.lv2/limiter_mono.ttl ]] && have_lsp=1

engine="clean"
if [[ $preset == podcast && -n $deepfilter ]]; then
  engine="deepfilter"
elif [[ $preset != clean && -n $rnnoise ]]; then
  engine="rnnoise"
fi

use_aec=0
if [[ $preset == meeting && -n $webrtc ]]; then
  use_aec=1
fi

# --dump is for tests. Do not replace the live runtime host.conf.
if [[ $dump -eq 1 ]]; then
  conf=$(mktemp)
  trap 'rm -f -- "$conf"' EXIT
else
  mkdir -p "$runtime_dir"
  conf="$runtime_dir/host.conf"
fi
capture_target=$target
if [[ $use_aec -eq 1 ]]; then
  capture_target="omavoice.aec"
fi

stream_props() {
  local name=$1
  local desc=$2
  local klass=$3
  local extra=${4:-}
  cat <<EOF
                node.name = "$name"
                node.description = "$desc"
                media.class = $klass
                audio.rate = 48000
                audio.position = [ MONO ]
                node.latency = 256/48000
$extra
EOF
}

# Light makeup after NS: ~2.5:1 into a −1 dB ceiling. LSP gains are linear.
# Attack threshold 0.251 ≈ −12 dB; makeup 2.0 ≈ +6 dB.
dynamics_nodes() {
  [[ $have_lsp -eq 1 ]] || return 0
  cat <<'EOF'
                    {
                        type = lv2
                        name = comp
                        plugin = "http://lsp-plug.in/plugins/lv2/compressor_mono"
                        control = {
                            "cm" = 0
                            "al" = 0.25119
                            "cr" = 2.5
                            "at" = 15.0
                            "rt" = 120.0
                            "mk" = 2.0
                        }
                    }
                    {
                        type = lv2
                        name = lim
                        plugin = "http://lsp-plug.in/plugins/lv2/limiter_mono"
                        control = {
                            "alr" = 0
                            "boost" = 0
                            "th" = 0.891
                            "g_in" = 1.0
                        }
                    }
EOF
}

cat >"$conf" <<EOF
context.properties = {
    log.level = 0
}

context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
    audio.aec       = aec/libspa-aec-webrtc
}

context.modules = [
    { name = libpipewire-module-rt
        args = { }
        flags = [ ifexists nofail ]
    }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
EOF

if [[ $use_aec -eq 1 ]]; then
  cat >>"$conf" <<EOF
    { name = libpipewire-module-echo-cancel
        flags = [ ifexists nofail ]
        args = {
            library.name = aec/libspa-aec-webrtc
            monitor.mode = true
            aec.args = {
                webrtc.gain_control = false
                webrtc.extended_filter = true
                webrtc.delay_agnostic = true
                webrtc.noise_suppression = false
                webrtc.high_pass_filter = true
            }
            source.props = {
                node.name = "omavoice.aec"
                node.description = "Omavoice echo cancel"
                media.class = Stream/Output/Audio/Internal
                node.virtual = true
                node.dont-fallback = true
                priority.session = 0
            }
            capture.props = {
                node.name = "omavoice.aec.capture"
                node.passive = true
                node.dont-fallback = true
                stream.dont-remix = true
                target.object = "$target"
            }
            playback.props = {
                node.name = "omavoice.aec.playback"
                node.passive = true
            }
        }
    }
EOF
fi

# Build the voice graph as an explicit series so PipeWire does not duplicate
# it per channel. Mono RNNoise/DFN ports are Input/Output; LSP uses in/out.
graph_head() {
  cat <<EOF
    { name = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {
            node.description = "Omavoice"
            media.name = "Omavoice"
            node.latency = 256/48000
            audio.rate = 48000
            audio.position = [ MONO ]
            filter.graph = {
                nodes = [
EOF
}

graph_tail() {
  cat <<EOF
                ]
$1
            }
            capture.props = {
                node.name = "omavoice.capture"
                node.passive = true
                node.dont-fallback = true
                stream.dont-remix = true
                audio.rate = 48000
                audio.position = [ MONO ]
                node.latency = 256/48000
                target.object = "$capture_target"
            }
            playback.props = {
                node.name = "omavoice"
                node.description = "Omavoice"
                media.class = Audio/Source
                node.virtual = true
                media.role = Communication
                session.suspend-timeout-seconds = 3
                stream.dont-remix = true
                audio.rate = 48000
                audio.position = [ MONO ]
                node.latency = 256/48000
            }
        }
    }
EOF
}

hpf_node() {
  cat <<'EOF'
                    {
                        type = builtin
                        name = hp
                        label = bq_highpass
                        control = { "Freq" = 80.0 "Q" = 0.707 }
                    }
EOF
}

copy_gain_node() {
  local name=$1
  cat <<EOF
                    {
                        type = builtin
                        name = $name
                        label = copy
                        control = { "Gain" = 1.0 }
                    }
EOF
}

eq_band_node() {
  local name=$1 freq=$2 q=$3
  cat <<EOF
                    {
                        type = builtin
                        name = $name
                        label = bq_peaking
                        control = { "Freq" = $freq "Q" = $q "Gain" = 0.0 }
                    }
EOF
}

eq_nodes() {
  eq_band_node eq.body 180 0.7
  eq_band_node eq.presence 2500 0.9
  eq_band_node eq.air 7000 0.7
}

rnnoise_node() {
  local vad=$1 grace=$2
  cat <<EOF
                    {
                        type = ladspa
                        name = denoise
                        plugin = "$rnnoise"
                        label = noise_suppressor_mono
                        control = {
                            "VAD Threshold (%)" = $vad
                            "VAD Grace Period (ms)" = $grace
                            "Retroactive VAD Grace (ms)" = 0
                        }
                    }
EOF
}

dfn_node() {
  local atten=$1
  cat <<EOF
                    {
                        type = ladspa
                        name = denoise
                        plugin = "$deepfilter"
                        label = deep_filter_mono
                        control = {
                            "Attenuation Limit (dB)" = $atten
                        }
                    }
EOF
}

meeting_vad=80.0
meeting_grace=400
podcast_vad=85.0
podcast_grace=200
podcast_dfn=70
case $quality in
  good)
    meeting_vad=70.0
    meeting_grace=500
    podcast_vad=75.0
    podcast_grace=400
    podcast_dfn=50
    ;;
  best)
    meeting_vad=85.0
    meeting_grace=250
    podcast_vad=90.0
    podcast_grace=150
    podcast_dfn=85
    ;;
esac

link_lines=""
add_link() {
  if [[ -n $link_lines ]]; then
    link_lines+=$'\n'
  fi
  link_lines+="                    { output = \"$1\" input = \"$2\" }"
}

finish_links() {
  printf '                links = [\n%s\n                ]\n                inputs = [ "preamp:In" ]\n                outputs = [ "outgain:Out" ]' "$link_lines"
}

{
  graph_head
  copy_gain_node preamp
  prev="preamp:Out"

  if [[ $preset == clean ]]; then
    hpf_node
    add_link "$prev" "hp:In"
    prev="hp:Out"
    copy_gain_node outgain
    add_link "$prev" "outgain:In"
  else
    if [[ $preset == podcast || $engine == deepfilter ]]; then
      hpf_node
      add_link "$prev" "hp:In"
      prev="hp:Out"
    fi

    if [[ $engine == rnnoise ]]; then
      if [[ $preset == podcast ]]; then
        rnnoise_node $podcast_vad $podcast_grace
      else
        rnnoise_node $meeting_vad $meeting_grace
      fi
      add_link "$prev" "denoise:Input"
      prev="denoise:Output"
    elif [[ $engine == deepfilter ]]; then
      dfn_node $podcast_dfn
      add_link "$prev" "denoise:Input"
      prev="denoise:Output"
    elif [[ $preset == meeting ]]; then
      hpf_node
      add_link "$prev" "hp:In"
      prev="hp:Out"
    fi

    eq_nodes
    add_link "$prev" "eq.body:In"
    add_link "eq.body:Out" "eq.presence:In"
    add_link "eq.presence:Out" "eq.air:In"
    prev="eq.air:Out"

    dynamics_nodes
    copy_gain_node outgain
    if [[ $have_lsp -eq 1 ]]; then
      add_link "$prev" "comp:in"
      add_link "comp:out" "lim:in"
      add_link "lim:out" "outgain:In"
    else
      add_link "$prev" "outgain:In"
    fi
  fi

  graph_tail "$(finish_links)"
} >>"$conf"

cat >>"$conf" <<EOF
]
EOF

if [[ $dump -eq 1 ]]; then
  cat "$conf"
  exit 0
fi

exec /usr/bin/pipewire -c "$conf"
