#!/usr/bin/env bash
# Live Props on omavoice.capture, and Meeting AEC monitor idle.
set -euo pipefail

usage() {
  echo "Usage: omavoice-ctl set [KEY VALUE ...] | aec-sync" >&2
  exit 2
}

cmd=${1:-}
[[ -n $cmd ]] || usage
shift

if [[ $cmd == aec-sync ]]; then
  exec python3 - <<'PY'
import json, subprocess, sys

def dump():
    return json.loads(subprocess.check_output(["pw-dump"]))

data = dump()
names = {}
for obj in data:
    props = (obj.get("info") or {}).get("props") or {}
    names[obj.get("id")] = props.get("node.name")

voice = next((i for i, n in names.items() if n == "omavoice"), None)
sink = next((i for i, n in names.items() if n == "omavoice.aec.sink"), None)
if voice is None or sink is None:
    sys.exit(0)

ignore = {"omavoice.meter.hold", "quickshell"}
real = False
sink_links = []
for obj in data:
    if obj.get("type") != "PipeWire:Interface:Link":
        continue
    props = (obj.get("info") or {}).get("props") or {}
    src, dst = props.get("link.output.node"), props.get("link.input.node")
    if src == voice:
        dest = names.get(dst) or ""
        if dest not in ignore:
            real = True
    if dst == sink:
        sink_links.append(obj.get("id"))

if real:
    if sink_links:
        sys.exit(0)
    sink_name = None
    for obj in data:
        if "Metadata" not in (obj.get("type") or ""):
            continue
        for meta in obj.get("metadata") or []:
            if meta.get("key") != "default.audio.sink":
                continue
            value = meta.get("value")
            if isinstance(value, str):
                try:
                    value = json.loads(value)
                except Exception:
                    value = {}
            if isinstance(value, dict):
                sink_name = value.get("name")
    if sink_name:
        subprocess.call(["pw-link", sink_name, "omavoice.aec.sink"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sys.exit(0)

for link_id in sink_links:
    if link_id is None:
        continue
    subprocess.call(["pw-cli", "destroy", str(link_id)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
PY
fi

[[ $cmd == set ]] || usage

node_id() {
  local name=$1
  pw-cli ls Node 2>/dev/null | awk -v want="$name" '
    /^id / { id=$2; sub(/,/, "", id) }
    $0 ~ "node.name = \"" want "\"" { print id; exit }
  '
}

id=$(node_id "omavoice.capture")
if [[ -z $id ]]; then
  id=$(node_id "omavoice")
fi
[[ -n $id ]] || exit 1
[[ $# -gt 0 ]] || exit 0
(( $# % 2 == 0 )) || usage

params=""
while [[ $# -gt 0 ]]; do
  params+=" \"$1\" $2"
  shift 2
done

exec pw-cli s "$id" Props "{ params = [$params ] }"
